package com.saleh.exam2;

import android.os.Bundle;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.TextView;

import androidx.annotation.NonNull;
import androidx.annotation.Nullable;
import androidx.fragment.app.Fragment;

public class TabFragment extends Fragment {

    private static final String ARG_TAB_NUMBER = "tab_number";

    public static TabFragment newInstance(int tabNumber) {
        TabFragment fragment = new TabFragment();
        Bundle args = new Bundle();
        args.putInt(ARG_TAB_NUMBER, tabNumber);
        fragment.setArguments(args);
        return fragment;
    }

    @Nullable
    @Override
    public View onCreateView(@NonNull LayoutInflater inflater,
                             @Nullable ViewGroup container,
                             @Nullable Bundle savedInstanceState) {
        View view = inflater.inflate(R.layout.fragment_tab, container, false);
        TextView tvTabTitle = view.findViewById(R.id.tvTabTitle);
        int tabNumber = getArguments() != null ? getArguments().getInt(ARG_TAB_NUMBER, 1) : 1;
        String[] names = {"First", "Second", "Third"};
        tvTabTitle.setText("This is the " + names[tabNumber - 1] + " Tab");
        return view;
    }
}
